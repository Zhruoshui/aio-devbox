# --- AI agent / editor state (local tooling, not project code) ---
# (.claude/ is NOT here — see the exceptions block below.)
.agents/
.codex/
.opencode/
.idea/
.vscode/
*.swp
*~

# --- Exceptions: project-level agent config IS repo code ---
# .claude/ ships with the repo in full (agents, commands, hooks, skills,
# settings.json) so worktree checkouts (multi-dev git workflow) get the
# complete hook + agent wiring, not just a subset. Only local state stays
# out: plans/ (per-session scratch) and settings.local.json.
.claude/plans/
.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db

# --- Trellis workflow state (SHARED via git) ---
# Tracked so the worktree-based multi-dev workflow shares one task board:
# tasks/ (prd/design/implement + task.json status), spec/, workspace/ journals
# and the scripts/workflow.md tooling all travel with branches and merges.
# Per-developer local state stays out via .trellis/.gitignore
# (.developer identity, .current-task pointer, .runtime/ session state).
# Convention: each dev mutates only their own task dirs / journal files, and
# merges main regularly to pick up teammates' task-status changes.

# --- Secrets (generated by `make hash`; NEVER commit) ---
.env
gateway/secrets/

# --- Rust build output (app/) ---
# NOTE: app/Cargo.lock IS committed (this is a binary crate, not a library).
app/target/

# --- Rust build output (config/, the aio-config build/host-side tool) ---
config/target/

# --- Generated static assets ---
# app/static/ is produced by the app image's web-builder stage (Phase C) from
# web/; it is a build artifact, not source.
app/static/

# --- Node / web (web/) ---
node_modules/
web/dist/

# --- Test artifacts ---
vnc-screenshot.png

# --- Scenario selection (machine-local; written by `make config`) ---
# The .example is committed as a seed; the real selection is per-machine.
.aio/enabled.toml

# --- Offline transfer artifacts (make save / make load) ---
aio-offline-bundle/

# --- Generated artifacts ---
# Dockerfile.base is assembled by `aio-config gen` from .aio/enabled.toml
# (per-machine, gitignored). Canonical path: `make build-base` runs gen first.
Dockerfile.base
