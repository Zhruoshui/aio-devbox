# --- AI agent / editor state (local tooling, not project code) ---
.agents/
.claude/
.codex/
.opencode/
.idea/
.vscode/
*.swp
*~

# --- Exception: aio-env-config skill IS project code ---
# It documents the repo's own layered scenario system, so it ships with the
# repo. git can't re-include a path whose parent dir is excluded, so the
# negation is step-by-step: re-open .claude/, ignore its contents, re-open
# .claude/skills/, ignore its contents, re-include only aio-env-config/.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/aio-env-config/

# --- OS ---
.DS_Store
Thumbs.db

# --- Trellis workflow state (per-developer tasks / journal / spec) ---
# Local workflow tooling, not part of the shipped project. The research archive
# under .trellis/tasks/archive/ is kept locally; track it in git only if you
# want shared research/conventions (then swap this for a negation pattern).
.trellis/

# --- Secrets (generated by `make hash`; NEVER commit) ---
.env
gateway/secrets/

# --- Rust build output (app/) ---
# NOTE: app/Cargo.lock IS committed (this is a binary crate, not a library).
app/target/

# --- Rust build output (config/, the aio-config build/host-side tool) ---
config/target/

# --- Generated static assets ---
# app/static/ is produced by the app image's web-builder stage (Phase C) from
# web/; it is a build artifact, not source.
app/static/

# --- Node / web (web/) ---
node_modules/
web/dist/

# --- Test artifacts ---
vnc-screenshot.png

# --- Scenario selection (machine-local; written by `make config`) ---
# The .example is committed as a seed; the real selection is per-machine.
.aio/enabled.toml
