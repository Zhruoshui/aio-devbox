# syntax=docker/dockerfile:1
#
# sandbox-base HEAD fragment. `aio-config gen` assembles the final
# Dockerfile.base as: this head + the enabled scenario fragments + the tail.
# This file holds the non-versioned root-context bootstrap every derived image
# shares: HTTPS apt, ca-cert self-bootstrap, build-essential. Everything runs
# as root; root is also the runtime default user and the workspace owner - the
# shared workspace volume mounts at /root (docker-compose.yml), so dotfiles
# persist on the volume.
# Versioned L1 runtimes (node, python) are `always_on` scenarios (baked
# unconditionally, version-selectable in the TUI) - they assemble right after
# this head. Scenario fragments insert AFTER this (still root, before the
# tail's `USER root` / `WORKDIR /root`).
#
# Fonts live HERE, not in a scenario (2026-09-22). The earlier `scenarios/fonts`
# was an `os`-category scenario - i.e. an L1 row the user could UNCHECK. That
# conflated two axes: `category` decided both the grouping AND whether the row
# could be turned off (issue #30, friction point 1). Fonts are non-versioned
# infrastructure with no version axis, so per layers.md they belong in the
# head: always present, never toggleable. Noto replaces the old Maple Mono NF
# CN - it covers CJK (Sans + Serif) and color emoji, and is the most widely
# deployed font family there is.
#
# Do NOT hand-edit the generated repo-root Dockerfile.base. Edit this head,
# scenarios/<id>/fragment.Dockerfile, or Dockerfile.base.tail, then re-run
# `make build-base` (which runs `gen`).
#
# Network note: this sandbox's network policy blocks plain HTTP (port 80) and
# the NodeSource host. apt is therefore pointed at HTTPS. Node and Python are
# NOT baked here anymore - they are `always_on` L1 scenarios (scenarios/node,
# scenarios/python) that fetch from nodejs.org / GitHub releases
# (python-build-standalone) over HTTPS. (opencode was previously baked here
# but moved to the L4 `opencode` scenario - AI agents belong in L4.)

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=UTC \
    PYTHONUNBUFFERED=1

# The proxy blocks HTTP (port 80); force HTTPS for apt sources (deb822 + legacy).
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
 && sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \
        /etc/apt/sources.list 2>/dev/null || true

# Bootstrap ca-certificates over HTTPS without peer verification (chicken-and-
# egg: HTTPS apt needs certs to verify, certs come from apt). Once installed,
# update-ca-certificates provisions the standard CA bundle and all subsequent
# HTTPS fetches verify normally.
RUN apt-get -o Acquire::https::Verify-Peer=false update \
 && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        curl git gnupg2 xz-utils \
        build-essential pkg-config libssl-dev \
        locales tzdata sudo \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# Fonts (Noto, always baked - see the header note). The base image starts with
# ZERO fonts, so any server-side text render (matplotlib, pandoc/HTML->PDF,
# headless screenshots) shows tofu boxes for CJK. Noto Sans CJK covers
# Simplified/Traditional Chinese, Japanese and Korean; Noto Color Emoji adds
# emoji. The web UI renders in the HOST browser and uses host fonts, so this
# scenario is about in-container rendering only.
#
# Why the /etc/fonts/local.conf aliases are REQUIRED (measured 2026-09-22):
# with DejaVu also present, fontconfig's default ordering picks DejaVu for
# monospace/sans-serif/serif - `fc-match "sans-serif:lang=zh"` lands on DejaVu,
# which has no CJK glyphs. Strong-binding aliases pin all three generic
# families to the Noto SC faces, so terminal/editors/renders are deterministic
# and tofu-free. The assertion below (not a print!) fails the build if any
# family slips back to a non-Noto font.
#
# Tradeoff (accepted): `monospace` becomes Noto Sans Mono CJK SC, which is a
# CJK-oriented mono face - no programming ligatures and weaker glyph
# disambiguation than DejaVu/Maple. Determinism + full CJK coverage won over
# Latin-only polish. (The old Maple Mono NF CN also carried Nerd Font icons;
# Noto has none - see docs/wiki/Scenarios.md for the icon fallback note.)
#
# apt lists were cleared at the end of the bootstrap RUN above, so re-update.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        fontconfig fonts-noto-cjk fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/* \
 && printf '%s\n' \
      '<?xml version="1.0"?>' \
      '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">' \
      '<fontconfig>' \
      '  <alias binding="strong"><family>monospace</family><prefer><family>Noto Sans Mono CJK SC</family></prefer></alias>' \
      '  <alias binding="strong"><family>sans-serif</family><prefer><family>Noto Sans CJK SC</family></prefer></alias>' \
      '  <alias binding="strong"><family>serif</family><prefer><family>Noto Serif CJK SC</family></prefer></alias>' \
      '</fontconfig>' > /etc/fonts/local.conf \
 && fc-cache -f \
# Assertions (not prints): every generic family must resolve to Noto, and the
# cmap must actually carry CJK + emoji glyphs. Any failure fails the build.
 && fc-match -f '%{family}\n' monospace | grep -qi noto \
 && fc-match -f '%{family}\n' 'sans-serif:lang=zh' | grep -qi noto \
 && fc-list ':charset=4e2d' family | grep -qi 'noto sans cjk sc' \
 && fc-list ':charset=1f600' family | grep -qi emoji \
 && fc-match -f '%{family}\n' emoji | grep -qi emoji

# No non-root user: root (uid 0) is the default (and only) user across every
# container that touches the shared workspace volume (R6 / R9). Historically a
# dedicated `gem` user (uid 1000) owned the workspace; switched to root.
