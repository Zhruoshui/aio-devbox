# syntax=docker/dockerfile:1
#
# sandbox-base HEAD fragment. `aio-config gen` assembles the final
# Dockerfile.base as: this head + the enabled scenario fragments + the tail.
# This file holds the root-context bootstrap every derived image shares:
# HTTPS apt, ca-cert self-bootstrap, node, user `gem`. Scenario fragments
# insert AFTER this (still root, before the tail's `USER gem`).
#
# Do NOT hand-edit the generated repo-root Dockerfile.base. Edit this head,
# scenarios/<id>/fragment.Dockerfile, or Dockerfile.base.tail, then re-run
# `make build-base` (which runs `gen`).
#
# Network note: this sandbox's network policy blocks plain HTTP (port 80) and
# the NodeSource host. apt is therefore pointed at HTTPS, and Node is installed
# from the official nodejs.org tarball. (opencode was previously baked here but
# moved to the L4 `opencode` scenario - AI agents belong in L4, not the L1 base.
# Its GitHub-release fetch lives in scenarios/opencode/fragment.Dockerfile.)

FROM debian:bookworm-slim

ARG NODE_VERSION=20.18.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=UTC \
    PYTHONUNBUFFERED=1

# The proxy blocks HTTP (port 80); force HTTPS for apt sources (deb822 + legacy).
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
 && sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \
        /etc/apt/sources.list 2>/dev/null || true

# Bootstrap ca-certificates over HTTPS without peer verification (chicken-and-
# egg: HTTPS apt needs certs to verify, certs come from apt). Once installed,
# update-ca-certificates provisions the standard CA bundle and all subsequent
# HTTPS fetches verify normally.
RUN apt-get -o Acquire::https::Verify-Peer=false update \
 && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates \
 && update-ca-certificates \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        curl git gnupg2 xz-utils \
        python3 python3-pip python3-venv \
        build-essential pkg-config libssl-dev \
        locales tzdata sudo \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# Node 20 LTS from the official tarball (NodeSource is blocked in this env).
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        -o /tmp/node.tar.xz \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz \
 && node --version && npm --version

# Workspace user `gem` (uid 1000), aligned across every container that touches
# the shared workspace volume (R6 / R9).
RUN groupadd --system --gid 1000 gem \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash gem \
 && mkdir -p /home/gem \
 && chown 1000:1000 /home/gem
