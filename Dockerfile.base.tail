# sandbox-base TAIL fragment. `aio-config gen` appends this AFTER all enabled
# scenario fragments. Everything above (head + scenarios) ran as root; this
# pins the final default user explicitly: root, whose home /root is the
# workspace - the shared workspace volume mounts over it at runtime, so
# terminal panes start there and dotfiles persist on the volume. Kept separate
# so scenarios can insert root-context install steps before the user switch.

USER root
WORKDIR /root
