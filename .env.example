# Gateway basic-auth username.
SANDBOX_USER=admin

# Password hash: docker-compose corrupts bcrypt hashes ('$' chars) passed via
# env, so the hash is stored in gateway/secrets/hash instead. Generate it with:
#   make hash                 # default password "admin"
#   make hash PASS=secret     # custom password
# (Runs `caddy hash-password` in a throwaway caddy container.)

# Host-side port pi-web's iframe is served on (issue #3). The in-sandbox port
# is always 30141; when the host republishes it (`sbx ports <sandbox>
# --publish 30142:30141/tcp`, or a second instance reusing the port range),
# set the HOST port here so docker-compose both publishes it and tells the app
# to render the iframe URL with it. Unset => 30141 (current behavior).
#PI_WEB_HOST_PORT=30142
