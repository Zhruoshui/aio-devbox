# Gateway basic-auth username.
SANDBOX_USER=admin

# Password hash: docker-compose corrupts bcrypt hashes ('$' chars) passed via
# env, so the hash is stored in gateway/secrets/hash instead. Generate it with:
#   make hash                 # default password "admin"
#   make hash PASS=secret     # custom password
# (Runs `caddy hash-password` in a throwaway caddy container.)

# Host-side port pi-web's iframe is served on (issue #3). When the host
# republishes it (an `sbx` sandbox mapping it to 30142, or a second instance
# reusing the port range), set the HOST port here so docker-compose both
# publishes it and tells the app to render the iframe URL with it. Unset =>
# 30141 (current behavior). NOTE the pairing: with this set, compose binds
# 30143 INSIDE the sandbox too (30143 -> container 30141), so the sbx publish
# must target the same sandbox-side port: `sbx ports <sandbox>
# --publish 30142:30143/tcp` (NOT :30141 - nothing listens on 30141 in the
# sandbox when the variable is set).
#PI_WEB_HOST_PORT=30143
